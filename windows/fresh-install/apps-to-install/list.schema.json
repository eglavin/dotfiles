{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "list.schema.json",
  "title": "Apps to install",
  "description": "Groups of apps to install on a fresh Windows install.",
  "type": "array",
  "items": {
    "$ref": "#/definitions/group"
  },
  "definitions": {
    "group": {
      "type": "object",
      "description": "A labelled group of apps.",
      "required": [
        "label",
        "apps"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Display name of the group."
        },
        "apps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/app"
          }
        }
      }
    },
    "app": {
      "type": "object",
      "description": "An app to install. Needs either a winget `id` or a `name`.",
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "id"
          ]
        },
        {
          "required": [
            "name"
          ]
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Winget package identifier, e.g. Git.Git."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable app name, for apps without a winget id."
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Extra arguments passed to the installer."
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Tags used to select which apps to install.",
          "examples": [
            [
              "all",
              "optional",
              "work"
            ]
          ]
        }
      }
    }
  }
}