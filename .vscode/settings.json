{
	"files.associations": {
		"ansible/**/*.yml": "ansible"
	},
	"files.exclude": {
		"**/.git": false
	},
	"ansible.ansible.path": "ansible",
	"ansible.python.interpreterPath": "python3",
	"evenBetterToml.schema.associations": {
		".config/mise/config.toml": "https://mise.jdx.dev/schema/mise.json"
	},
	"json.schemas": [
		{
			"fileMatch": ["**/apps-to-install/list.jsonc"],
			"url": "./windows/fresh-install/apps-to-install/list.schema.json"
		}
	]
}